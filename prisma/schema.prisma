generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                 @id @default(cuid())
  name                         String?
  email                        String                 @unique
  emailVerified                DateTime?
  image                        String?
  passwordHash                 String?
  role                         UserRole               @default(MANAGER)
  createdAt                    DateTime               @default(now())
  updatedAt                    DateTime               @updatedAt
  accounts                     Account[]
  createdEmployeeInvitations   EmployeeInvitation[]   @relation("CreatedEmployeeInvitations")
  employeeInvitations          EmployeeInvitation[]
  files                        File[]
  passwordResetEvents          PasswordResetEvent[]   @relation("PasswordResetEventActor")
  handledPasswordResetRequests PasswordResetRequest[] @relation("PasswordResetRequestHandledBy")
  passwordResetRequests        PasswordResetRequest[] @relation("PasswordResetRequestUser")
  passwordResetTokens          PasswordResetToken[]
  sessions                     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmployeeInvitation {
  id                     String                @id @default(cuid())
  email                  String
  tokenHash              String                @unique
  role                   UserRole              @default(MANAGER)
  status                 InvitationStatus      @default(PENDING)
  expiresAt              DateTime
  acceptedAt             DateTime?
  userId                 String
  createdById            String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  passwordResetRequestId String?               @unique
  createdBy              User?                 @relation("CreatedEmployeeInvitations", fields: [createdById], references: [id])
  passwordResetRequest   PasswordResetRequest? @relation(fields: [passwordResetRequestId], references: [id])
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
  @@index([createdById])
}

model PasswordResetToken {
  id        String               @id @default(cuid())
  tokenHash String               @unique
  expiresAt DateTime
  userId    String
  createdAt DateTime             @default(now())
  requestId String               @unique
  request   PasswordResetRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id          String                     @id @default(cuid())
  userId      String
  email       String
  role        UserRole
  locale      String                     @default("uk")
  status      PasswordResetRequestStatus @default(NEW)
  expiresAt   DateTime
  viewedAt    DateTime?
  handledAt   DateTime?
  completedAt DateTime?
  handledById String?
  emailError  String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  invitation  EmployeeInvitation?
  events      PasswordResetEvent[]
  handledBy   User?                      @relation("PasswordResetRequestHandledBy", fields: [handledById], references: [id])
  user        User                       @relation("PasswordResetRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  token       PasswordResetToken?

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([handledById])
}

model PasswordResetEvent {
  id        String                 @id @default(cuid())
  requestId String
  type      PasswordResetEventType
  actorId   String?
  details   String?
  createdAt DateTime               @default(now())
  actor     User?                  @relation("PasswordResetEventActor", fields: [actorId], references: [id])
  request   PasswordResetRequest   @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@index([actorId])
}

model RequestStatus {
  id          String             @id @default(cuid())
  code        String             @unique
  titleUk     String
  titleEn     String
  description String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  requests    TransportRequest[]
}

model TransportRequest {
  id              String        @id @default(cuid())
  requestNumber   String        @unique
  name            String
  phone           String
  email           String?
  company         String?
  origin          String?
  destination     String?
  cargoType       String?
  temperatureMode String?
  weight          String?
  comment         String?
  preferredDate   DateTime?
  emailSent       Boolean       @default(false)
  emailError      String?
  statusId        String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  type            RequestType   @default(ORDER)
  status          RequestStatus @relation(fields: [statusId], references: [id])
}

model Manager {
  id         String   @id @default(cuid())
  name       String
  role       String
  phone      String
  email      String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  messengers String[] @default([])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  titleUk     String
  titleEn     String
  summaryUk   String
  summaryEn   String
  bodyUk      String
  bodyEn      String
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Vehicle {
  id              String   @id @default(cuid())
  title           String
  brand           String?
  payloadTonnes   Decimal  @db.Decimal(5, 2)
  temperatureFrom Int
  temperatureTo   Int
  volume          String?
  photoPublicId   String?
  photoUrl        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  description     String?
}

model File {
  id         String   @id @default(uuid())
  url        String
  key        String   @unique
  mimeType   String
  size       Int
  entityType String
  entityId   String?
  userId     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
}

model GeographyRoute {
  id          String   @id @default(cuid())
  origin      String
  destination String
  country     String
  direction   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Review {
  id               String       @id @default(cuid())
  author           String
  company          String?
  body             String
  rating           Int          @default(5)
  isPublished      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  moderationStatus ReviewStatus @default(PENDING)
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleUk     String
  titleEn     String
  excerptUk   String
  excerptEn   String
  contentUk   String
  contentEn   String
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vacancy {
  id                      String                   @id @default(cuid())
  titleUk                 String
  titleEn                 String
  location                String
  description             String
  isPublished             Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  requirements            String?
  salary                  String?
  status                  VacancyStatus            @default(ACTIVE)
  cooperationApplications CooperationApplication[]
  applications            VacancyApplication[]
}

model VacancyApplication {
  id         String   @id @default(cuid())
  vacancyId  String
  name       String
  phone      String
  email      String?
  comment    String?
  cvUrl      String?
  cvPublicId String?
  createdAt  DateTime @default(now())
  vacancy    Vacancy  @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
}

model CooperationApplication {
  id              String                       @id @default(cuid())
  vacancyId       String?
  customDirection String?
  name            String
  phone           String
  email           String
  city            String
  comment         String?
  status          CooperationApplicationStatus @default(NEW)
  emailSent       Boolean                      @default(false)
  emailError      String?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  vacancy         Vacancy?                     @relation(fields: [vacancyId], references: [id])

  @@index([vacancyId])
  @@index([status, createdAt])
}

model FaqItem {
  id          String   @id @default(cuid())
  questionUk  String
  questionEn  String
  answerUk    String
  answerEn    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  OWNER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
}

enum PasswordResetRequestStatus {
  NEW
  VIEWED
  COMPLETED
  EXPIRED
  FAILED
  CANCELLED
}

enum PasswordResetEventType {
  CREATED
  VIEWED
  RESET_LINK_CREATED
  EMAIL_SENT
  EMAIL_FAILED
  COMPLETED
  EXPIRED
  CANCELLED
}

enum RequestType {
  CONSULTATION
  ORDER
  FAQ
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

enum VacancyStatus {
  ACTIVE
  ARCHIVED
}

enum CooperationApplicationStatus {
  NEW
  CONTACTED
  ARCHIVED
}
